# ==============================================================================
# CognoDB Cloud Benchmarking Environment Configuration
# Copy this file to .env and populate with your credentials.
# ==============================================================================

# CognoDB Cloud credentials (free c0 tier instance)
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=your_cognodb_password_here

# Neo4j AuraDB / Self-Hosted Neo4j credentials
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# Memgraph credentials
MEMGRAPH_URI=bolt://localhost:7688
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# FalkorDB / RedisGraph credentials
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# Kùzu Database path (embedded high-performance columnar graph DB)
KUZU_DB_PATH=./kuzu_db_data

# Benchmark settings
BENCHMARK_ITERATIONS=100
WARMUP_ITERATIONS=20
CONCURRENCY_LEVELS=1,10,40
DATASET_RELATIONSHIPS=100000
